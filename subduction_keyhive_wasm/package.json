{
  "name": "@automerge/subduction-keyhive",
  "version": "0.1.0",
  "private": true,
  "description": "Keyhive with the Subduction keyhive sync protocol (Wasm bindings)",
  "keywords": [
    "keyhive",
    "subduction",
    "wasm"
  ],
  "author": "Ink & Switch",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkandswitch/subduction",
    "directory": "subduction_keyhive_wasm"
  },
  "type": "module",
  "main": "./dist/cjs/node.cjs",
  "module": "./dist/esm/bundler.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": {
        "import": "./dist/esm/workerd.js",
        "require": "./dist/cjs/web.cjs"
      },
      "node": {
        "import": "./dist/esm/node.js",
        "require": "./dist/cjs/node.cjs"
      },
      "browser": {
        "import": "./dist/esm/bundler.js",
        "require": "./dist/cjs/web.cjs"
      },
      "import": "./dist/esm/web.js",
      "require": "./dist/cjs/web.cjs"
    },
    "./slim": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/slim.js",
      "require": "./dist/cjs/slim.cjs"
    },
    "./wasm": "./dist/subduction-keyhive.wasm",
    "./wasm-base64": {
      "import": "./dist/esm/wasm-base64.js",
      "require": "./dist/cjs/wasm-base64.cjs"
    },
    "./iife": "./dist/iife/index.js"
  },
  "sideEffects": [
    "./dist/esm/bundler.js",
    "./dist/esm/node.js",
    "./dist/esm/web.js",
    "./dist/esm/workerd.js"
  ],
  "scripts": {
    "build": "wasm-bodge build --panic abort --no-wasm-opt"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}