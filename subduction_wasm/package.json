{
  "name": "@automerge/subduction",
  "version": "0.26.0",
  "description": "Wasm/JavaScript bindings for Subduction (browser and Node.js)",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/wrapper/cjs/node.cjs",
  "scripts": {
    "build": "wasm-bodge build --debug-profile wasm-debug",
    "build-node": "wasm-pack build --out-dir pkg-node --target nodejs --release",
    "build-bundler": "wasm-pack build --out-dir pkg --target bundler --release",
    "build-slim": "node build_slim.js",
    "test": "playwright test",
    "test:pojo": "bash ../scripts/test-pojo-api.sh",
    "test:install": "playwright install",
    "test:report": "playwright show-report"
  },
  "keywords": [
    "automerge",
    "crdt",
    "subduction",
    "sync",
    "wasm"
  ],
  "author": "Alex Good <alex@patternist.xyz>, Brooklyn Zelenka <hello@brooklynzelenka.com>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/inkandswitch/subduction",
    "directory": "subduction_wasm"
  },
  "homepage": "https://github.com/inkandswitch/subduction",
  "bugs": {
    "url": "https://github.com/inkandswitch/subduction/issues"
  },
  "type": "module",
  "module": "./dist/wrapper/esm/bundler.js",
  "types": "./dist/wrapper/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/esm/node.js",
    "./dist/esm/web.js",
    "./dist/esm/workerd.js",
    "./dist/esm/bundler.js",
    "./dist/esm/debug-bundler.js",
    "./dist/esm/debug-node.js",
    "./dist/esm/debug-web.js",
    "./dist/esm/debug-workerd.js",
    "./dist/wrapper/esm/bundler.js",
    "./dist/wrapper/esm/node.js",
    "./dist/wrapper/esm/web.js",
    "./dist/wrapper/esm/workerd.js",
    "./dist/wrapper/esm/debug-bundler.js",
    "./dist/wrapper/esm/debug-node.js",
    "./dist/wrapper/esm/debug-web.js",
    "./dist/wrapper/esm/debug-workerd.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/wrapper/index.d.ts",
      "workerd": {
        "import": "./dist/wrapper/esm/workerd.js",
        "require": "./dist/wrapper/cjs/web.cjs"
      },
      "node": {
        "import": "./dist/wrapper/esm/node.js",
        "require": "./dist/wrapper/cjs/node.cjs"
      },
      "browser": {
        "import": "./dist/wrapper/esm/bundler.js",
        "require": "./dist/wrapper/cjs/web.cjs"
      },
      "import": "./dist/wrapper/esm/web.js",
      "require": "./dist/wrapper/cjs/web.cjs"
    },
    "./slim": {
      "types": "./dist/wrapper/slim.d.ts",
      "import": "./dist/wrapper/esm/slim.js",
      "require": "./dist/wrapper/cjs/slim.cjs"
    },
    "./wasm": "./dist/subduction.wasm",
    "./wasm-base64": {
      "import": "./dist/esm/wasm-base64.js",
      "require": "./dist/cjs/wasm-base64.cjs"
    },
    "./iife": "./dist/wrapper/iife/index.js",
    "./debug": {
      "types": "./dist/wrapper/index.d.ts",
      "workerd": {
        "import": "./dist/wrapper/esm/debug-workerd.js",
        "require": "./dist/wrapper/cjs/debug-web.cjs"
      },
      "node": {
        "import": "./dist/wrapper/esm/debug-node.js",
        "require": "./dist/wrapper/cjs/debug-node.cjs"
      },
      "browser": {
        "import": "./dist/wrapper/esm/debug-bundler.js",
        "require": "./dist/wrapper/cjs/debug-web.cjs"
      },
      "import": "./dist/wrapper/esm/debug-web.js",
      "require": "./dist/wrapper/cjs/debug-web.cjs"
    },
    "./debug/slim": {
      "types": "./dist/wrapper/slim.d.ts",
      "import": "./dist/wrapper/esm/debug-slim.js",
      "require": "./dist/wrapper/cjs/debug-slim.cjs"
    },
    "./debug/wasm": "./dist/subduction-debug.wasm",
    "./debug/wasm-base64": {
      "import": "./dist/esm/debug-wasm-base64.js",
      "require": "./dist/cjs/debug-wasm-base64.cjs"
    },
    "./debug/iife": "./dist/wrapper/iife/debug.js"
  },
  "wasm-bodge": {
    "wrapper": {
      "entry": "./js/index.ts",
      "tsconfig": "./tsconfig.json",
      "exposeBindings": false
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "fake-indexeddb": "^6.2.5",
    "html-webpack-plugin": "^5.6.8",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-wasm": "^3.6.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  },
  "imports": {
    "#wasm-bodge/bindings": {
      "types": "./dist/index.d.ts",
      "workerd": {
        "import": "./dist/esm/workerd.js",
        "require": "./dist/cjs/web.cjs"
      },
      "node": {
        "import": "./dist/esm/node.js",
        "require": "./dist/cjs/node.cjs"
      },
      "browser": {
        "import": "./dist/esm/bundler.js",
        "require": "./dist/cjs/web.cjs"
      },
      "import": "./dist/esm/web.js",
      "require": "./dist/cjs/web.cjs"
    },
    "#wasm-bodge/bindings/slim": {
      "types": "./dist/wasm_bindgen/web/subduction_wasm.d.ts",
      "import": "./dist/esm/slim.js",
      "require": "./dist/cjs/slim.cjs"
    },
    "#wasm-bodge/bindings/debug": {
      "types": "./dist/index.d.ts",
      "workerd": {
        "import": "./dist/esm/debug-workerd.js",
        "require": "./dist/cjs/debug-web.cjs"
      },
      "node": {
        "import": "./dist/esm/debug-node.js",
        "require": "./dist/cjs/debug-node.cjs"
      },
      "browser": {
        "import": "./dist/esm/debug-bundler.js",
        "require": "./dist/cjs/debug-web.cjs"
      },
      "import": "./dist/esm/debug-web.js",
      "require": "./dist/cjs/debug-web.cjs"
    },
    "#wasm-bodge/bindings/debug/slim": {
      "types": "./dist/wasm_bindgen/web/subduction_wasm.d.ts",
      "import": "./dist/esm/debug-slim.js",
      "require": "./dist/cjs/debug-slim.cjs"
    }
  }
}